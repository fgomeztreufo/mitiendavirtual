{
  "name": "07 – Referral Activation Cron",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Cada 1 hora",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/referrals?status=eq.pending&select=id,referred_id,referrer_id",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "options": {
          "response": { "response": { "responseFormat": "json" } }
        }
      },
      "id": "fetch-pending",
      "name": "Obtener referidos pendientes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300],
      "notesInFlow": true,
      "notes": "GET /rest/v1/referrals?status=eq.pending"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "has-items",
              "leftValue": "={{ $json.length || ($input.all().length) }}",
              "rightValue": "0",
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-has-pending",
      "name": "¿Hay pendientes?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "jsCode": "// Separar array de referidos en items individuales\nconst items = $input.first().json;\nif (Array.isArray(items)) {\n  return items.map(r => ({ json: r }));\n}\nreturn [{ json: items }];"
      },
      "id": "split-referrals",
      "name": "Split referidos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/check_referral_activation",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_referred_id: $json.referred_id }) }}",
        "options": {
          "response": { "response": { "responseFormat": "json" } }
        }
      },
      "id": "call-activation-rpc",
      "name": "check_referral_activation RPC",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 240],
      "notesInFlow": true,
      "notes": "Llama RPC por cada referido pendiente"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "was-activated",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-activated",
      "name": "¿Se activó?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1320, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SITE_URL || 'https://mitiendavirtual.cl' }}/api/send-push-notification",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-push-secret", "value": "={{ $env.WPP_TEMPLATE_SECRET }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ user_id: $json.referrer_id, title: '¡Referido activado!', body: 'Tu referido se activó. Ganaste 500 créditos IA.' }) }}",
        "options": {
          "response": { "response": { "responseFormat": "json" } },
          "timeout": 10000
        }
      },
      "id": "notify-referrer",
      "name": "Push al referidor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 180],
      "notesInFlow": true,
      "notes": "Notifica al referidor que ganó créditos"
    },
    {
      "parameters": {},
      "id": "no-pending",
      "name": "Sin pendientes",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [880, 380]
    },
    {
      "parameters": {},
      "id": "not-activated",
      "name": "Aún no activado",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1540, 320]
    }
  ],
  "connections": {
    "Cada 1 hora": {
      "main": [[{ "node": "Obtener referidos pendientes", "type": "main", "index": 0 }]]
    },
    "Obtener referidos pendientes": {
      "main": [[{ "node": "¿Hay pendientes?", "type": "main", "index": 0 }]]
    },
    "¿Hay pendientes?": {
      "main": [
        [{ "node": "Split referidos", "type": "main", "index": 0 }],
        [{ "node": "Sin pendientes", "type": "main", "index": 0 }]
      ]
    },
    "Split referidos": {
      "main": [[{ "node": "check_referral_activation RPC", "type": "main", "index": 0 }]]
    },
    "check_referral_activation RPC": {
      "main": [[{ "node": "¿Se activó?", "type": "main", "index": 0 }]]
    },
    "¿Se activó?": {
      "main": [
        [{ "node": "Push al referidor", "type": "main", "index": 0 }],
        [{ "node": "Aún no activado", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    { "name": "cron" },
    { "name": "referrals" }
  ]
}
